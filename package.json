{
  "name": "mailroom",
  "version": "0.9.1",
  "description": "mailroom — correio por tópicos com assistente de IA",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "demo": "DEMO=1 node server.js",
    "app": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "keywords": [],
  "author": "David Ferreira Marques",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "dotenv": "^18.0.10",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "ical.js": "^2.2.1",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "mailroom",
  "build": {
    "appId": "io.monco.mailroom",
    "productName": "mailroom",
    "files": [
      "server.js",
      "updater.js",
      "core/**",
      "public/**",
      "electron/**",
      "package.json",
      "!core/README.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "mailroom-setup-${version}.${ext}",
      "shortcutName": "mailroom"
    },
    "linux": {
      "target": "dir",
      "icon": "electron/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dferreiramarques",
        "repo": "mailroom",
        "releaseType": "release"
      }
    ]
  }
}
