# Fornecedor de IA por omissão (também se pode configurar na app, em Definições).
# anthropic (por omissão) ou openai (= qualquer API compatível: OpenAI, OpenRouter, Gemini, Ollama…)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Para openai/compatível:
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
PORT=4321
# Só se publicares a app fora do teu computador. Ativa login e escuta em 0.0.0.0.
APP_PASSWORD=
# Contas em JSON (alternativa ao accounts.json, útil no Railway)
# ACCOUNTS_JSON=[{"id":"monco", ...}]
# Pasta para rascunhos e definições (no Railway: /data, com um Volume)
# DATA_DIR=
